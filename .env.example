# Copy to .env and adjust as needed. docker-compose.yml sets most of these
# directly for the fluxen service when using the default compose stack
# (OPENAI_API_KEY is the exception — export it in your shell, or put it in
# a .env file next to docker-compose.yml, so compose can pass it through).
# This file also documents them for local (non-Docker) development of
# cmd/fluxen and fluxenctl.

# Deployment label, no behavioral effect.
FLUXEN_ENV=development

# Address the combined fluxen binary listens on.
HTTP_ADDR=:8080

# One of: debug, info, warn, error.
LOG_LEVEL=info

# Required. Standard PostgreSQL connection string.
DATABASE_URL=postgres://fluxen:fluxen@localhost:5432/fluxen?sslmode=disable

# Required. Standard Redis connection string.
REDIS_URL=redis://localhost:6379/0

# Optional. The gateway's deployment-wide OpenAI API key. Without it, the
# gateway still boots, but every /v1/chat/completions call returns
# 503 no_provider_credential until it's set. (This is a Phase 1
# simplification — see internal/config.Config.OpenAIAPIKey's doc comment.)
OPENAI_API_KEY=

# Optional. Overrides the OpenAI API base URL — only useful for pointing
# the gateway at a mock server in local development/testing.
FLUXEN_OPENAI_BASE_URL=

# Optional. The browser origin the control API allows to make credentialed
# cross-origin requests (CORS). Defaults to http://localhost:3000, which
# matches the dashboard's default compose port.
FLUXEN_DASHBOARD_ORIGIN=http://localhost:3000
