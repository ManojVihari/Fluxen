# Copy to .env and adjust as needed. docker-compose.yml sets these directly
# for the fluxen service when using the default compose stack; this file
# documents them for local (non-Docker) development of cmd/fluxen and
# fluxenctl.

# Deployment label, no behavioral effect in Phase 0.
FLUXEN_ENV=development

# Address the combined fluxen binary listens on.
HTTP_ADDR=:8080

# One of: debug, info, warn, error.
LOG_LEVEL=info

# Required. Standard PostgreSQL connection string.
DATABASE_URL=postgres://fluxen:fluxen@localhost:5432/fluxen?sslmode=disable

# Required. Standard Redis connection string.
REDIS_URL=redis://localhost:6379/0
